<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="5dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5"
        android:padding="5dp"
        >
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:orientation="vertical"
            android:layout_weight="3">
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/stock_code_trade_list"
            android:text="stock code"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"/>
        <com.google.android.material.textview.MaterialTextView
                android:id="@+id/buy_price_trade_list"
                android:text="stock code"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>
        <com.google.android.material.textview.MaterialTextView
                android:id="@+id/no_share_trade_list"
                android:text="No. of Shares"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/no_total_cost_list"
                android:text="No. of Shares"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>
    </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_trade"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorDownTrend"
            android:layout_margin="5dp"
            android:textSize="9sp"
            app:cornerRadius="100dp"
            android:text="Delete"
            android:layout_height="wrap_content"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_trade"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_margin="5dp"
            android:text="Edit"
            android:textSize="9sp"
            app:cornerRadius="100dp"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>