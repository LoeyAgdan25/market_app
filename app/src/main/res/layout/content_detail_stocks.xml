<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:card_view="http://schemas.android.com/tools">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:layout_margin="10dp"
        app:cardCornerRadius="5dp"
        app:cardElevation="5dp"
        >
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="150dp">
            <TextView
                android:id="@+id/txt_stock_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                style="@style/Base.TextAppearance.AppCompat.Large"
                android:textColor="#000"
                android:layout_alignParentLeft="true"
                android:text="Stock Code"
                android:textStyle="bold"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                />
            <TextView
                android:id="@+id/txt_company_description"
                android:layout_width="200dp"
                android:height="45dp"
                android:layout_height="wrap_content"
                android:scrollHorizontally="false"
                android:text="Company Description"
                android:layout_below="@+id/txt_stock_symbol"
                android:layout_marginTop="5dp"
                style="@style/Base.TextAppearance.AppCompat.Small"
                android:layout_marginLeft="10dp"
                />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/txt_company_description"
                    >
                <com.google.android.material.button.MaterialButton

                    android:id="@+id/btn_view_fundamentals"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="0dp"
                    app:icon="@drawable/ic_action_news"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:cornerRadius="15dp"
                    android:layout_marginLeft="10dp"
                    android:text="Funda."
                    android:textSize="10sp"
                    android:textAllCaps="false"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_news"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:elevation="0dp"
                    app:icon="@drawable/ic_action_news"
                    app:cornerRadius="15dp"
                    android:textAllCaps="false"
                    android:layout_below="@id/txt_company_description"
                    android:layout_marginLeft="10dp"
                    android:text="News"
                    android:textSize="10sp"
                    />
                </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                android:layout_alignParentRight="true"
                android:layout_marginTop="10dp"
                android:weightSum="1"
                >
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/txt_stock_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:textColor="@color/colorWhite"
                    android:padding="5dp"
                    android:text="Percentage"
                    style="@style/Base.TextAppearance.AppCompat.Medium"
                    android:layout_gravity="right"
                    android:layout_marginBottom="10dp"
                    />
                <TextView
                    android:id="@+id/txt_stock_volume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Volume"
                    style="@style/Base.TextAppearance.AppCompat.Small"
                    android:layout_gravity="right"
                    android:layout_marginRight="10dp"
                    />
                <TextView
                    android:id="@+id/txt_stock_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:text="Status"
                    style="@style/Base.TextAppearance.AppCompat.Small"
                    android:layout_gravity="right"
                    />
            </LinearLayout>
            <TextView
                android:id="@+id/txt_stock_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#000"
                android:layout_marginTop="8dp"
                android:text="Price"
                android:layout_alignParentBottom="true"
                android:layout_alignParentRight="true"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_margin="10dp"
                android:layout_gravity="right"
                />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>