<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".auth.LoginActivity"
    android:theme="@style/AppTheme"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBg"
    >
    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:background="@drawable/background_splash"
        />
    <ProgressBar
        android:id="@+id/login_progress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="@string/app_name"
                   android:textStyle="bold"
                   android:drawableLeft="@drawable/ic_show_chart_green_500_24dp"
                   android:layout_gravity="center_horizontal"
                   android:textColor="@color/colorAccent"
                   android:textSize="20sp"
                   />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="24dp"
                    android:theme="@style/AppTheme"
                    android:elevation="1dp"
                    app:cardCornerRadius="10dp"
                    >
                    <LinearLayout
                        android:id="@+id/linear_progress_circular"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_marginTop="20dp"
                        android:visibility="gone"
                        android:layout_margin="30dp"
                        >
                        <ProgressBar
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:indeterminate="true"
                            />
                        <TextView
                            android:layout_marginTop="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:textSize="14sp"
                            android:text="Please wait this will not take a wile"
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/field_layout_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_margin="8dp"
                        ><TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sign in"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_gravity="center_horizontal"
                            android:layout_margin="10dp">
                        </TextView>
                        <com.google.android.material.textfield.TextInputLayout
                                style="@style/LoginTextInputLayoutStyle"
                                android:id="@+id/txt_username_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColorHint="@color/colorAccent"
                                android:layout_margin="8dp"
                                app:errorEnabled="true"
                                app:startIconDrawable="@drawable/ic_perm_identity_teal_a200_24dp"
                                app:startIconTint="#cccc"
                                app:endIconMode="clear_text"
                                android:hint="Email">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/txt_username"
                                    android:textAllCaps="false"
                                    android:inputType="textEmailAddress|textNoSuggestions"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"/>
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/LoginTextInputLayoutStyle"
                                android:id="@+id/password_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Password"
                                app:errorEnabled="true"
                                android:textColorHint="@color/colorAccent"
                                android:layout_margin="8dp"
                                app:startIconDrawable="@drawable/ic_vpn_key_teal_a200_24dp"
                                app:startIconTint="#cccc"
                                app:endIconMode="password_toggle"
                                ><com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/password"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textPassword"
                                    android:textSize="14sp"
                                    />
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/email_sign_in_button"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sign in"
                                android:layout_margin="8dp"
                                app:cornerRadius="20dp"
                                android:backgroundTint="@color/colorAccent"
                                android:textStyle="bold"
                                />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:visibility="visible"
                >
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/email_sign_up_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign up here"
                    android:textAllCaps="false"
                    android:textColor="#1faa00"
                    android:textStyle="bold"
                    android:layout_alignParentLeft="true"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    />
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/forgot_password_in_button"
                    android:visibility="gone"
                    android:text="Forgot Password"
                    android:layout_alignParentRight="true"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    />
            </RelativeLayout>
        </LinearLayout>
        <Button
             android:visibility="gone"
             android:id="@+id/btn_open_privacy"
             android:layout_marginTop="100dp"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:background="@android:color/transparent"
             android:text="Privacy Policy"
             android:textColor="@color/colorPrimaryDark"/>
</FrameLayout>